{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ostendorf-dev",
  "type": "object",
  "required": ["image", "service"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "required": ["type", "port", "adminPort"],
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostnames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "annotations": { "type": "object" },
        "parentRefs": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the Gateway this HTTPRoute attaches to. Required when httpRoute.enabled is true; enforced by a template fail guard, not minLength, matching this chart's existing pattern for a value with no usable default."
            },
            "namespace": {
              "type": "string",
              "description": "Namespace the Gateway lives in. Required when httpRoute.enabled is true; see parentRefs.name's own description."
            },
            "sectionName": { "type": "string" }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "trustedProxyCidrs": {
          "type": "string",
          "description": "Comma separated CIDRs of the proxies in front of the service (TRUSTED_PROXIES). Empty trusts no X-Forwarded-For header."
        },
        "umami": {
          "type": "object",
          "description": "Server side page view counting. Off unless both values are set; neither is a secret.",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(https?://[^/?#@\\s]+(/[^?#\\s]*)?)?$",
              "description": "Base URL of the Umami instance (UMAMI_URL), no credentials, query or fragment."
            },
            "websiteId": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$",
              "description": "UUID of the website in Umami (UMAMI_WEBSITE_ID)."
            }
          }
        },
        "cvd": {
          "type": "object",
          "description": "The cv service the data pages read at runtime. None of these values is a secret.",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(https?://[^/?#@\\s]+(/[^?#\\s]*)?)?$",
              "description": "Base URL of cvd (CVD_URL), no credentials, query or fragment. Empty serves the placeholder on the data pages."
            },
            "cacheTtl": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))*$",
              "description": "Go duration after which a request triggers a refresh (CVD_CACHE_TTL). Empty keeps the application default of 5m."
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))*$",
              "description": "Go duration bounding one call to cvd (CVD_TIMEOUT, 1s to 30s). Empty keeps the application default of 5s."
            }
          }
        }
      }
    },
    "resources": { "type": "object" },
    "startupProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
